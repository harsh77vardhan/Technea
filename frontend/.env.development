# -----------------------------------------------------------------------------
# Technea Development Environment Configuration (Localhost)
# Loaded automatically by Vite during `npm run dev`
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Temporary Development Mode Authentication Bypass (Localhost only)
# Set to 'true' to skip authentication and load mock session directly on localhost
# Set to 'false' to test real authentication flow with backend
# -----------------------------------------------------------------------------
VITE_DEV_BYPASS_AUTH=true
