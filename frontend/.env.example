# -----------------------------------------------------------------------------
# Technea Frontend Environment Configuration
# -----------------------------------------------------------------------------
# Public API and Backend URL (used by Vite client)
#
# For Local Development:
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_BACKEND_URL=http://localhost:8000
#
# For Production (e.g. Vercel Project Settings):
# VITE_API_URL=https://technea-backend.onrender.com/api/v1
# VITE_BACKEND_URL=https://technea-backend.onrender.com
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_BACKEND_URL=http://localhost:8000

# Optional development auth bypass flag (localhost only, default: false)
VITE_DEV_BYPASS_AUTH=false
