# ==============================================================================
# Technea - Monorepo Production Environment Variables Template
# ==============================================================================
# This template documents all production environment variables across both
# the React/Vite Frontend and the FastAPI Backend services.
# ==============================================================================

# ==============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Vercel)
# ==============================================================================
# Configure these in your Vercel Project Settings > Environment Variables:

# Backend API endpoint URL (including /api/v1 prefix)
VITE_API_URL="https://technea-backend.onrender.com/api/v1"

# Fallback API base URL (including /api/v1 prefix)
VITE_API_BASE_URL="https://technea-backend.onrender.com/api/v1"

# Backend root host URL (used for resolving /static and /uploads asset URLs)
VITE_BACKEND_URL="https://technea-backend.onrender.com"

# ==============================================================================
# 2. BACKEND ENVIRONMENT VARIABLES (FastAPI / Render / Railway / Docker)
# ==============================================================================
# Configure these in your Render / Railway / Cloud Provider Dashboard:

# Application runtime mode
ENVIRONMENT="production"
DEBUG=False
PROJECT_NAME="Technea API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security & Session Tokens
# Generate via: openssl rand -hex 32
SECRET_KEY="replace-with-a-cryptographically-secure-random-32-byte-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Whitelist (Must match the production URL of your Frontend)
# Accepts JSON array or comma-separated URLs
CORS_ORIGINS=["https://technea.vercel.app","https://yourdomain.com"]

# Canonical Frontend URL (used for email verification links and CORS)
FRONTEND_URL="https://technea.vercel.app"

# Managed PostgreSQL Database URLs
# Render / Neon / Supabase / Railway:
DATABASE_URL="postgresql+asyncpg://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?sslmode=require"
SYNC_DATABASE_URL="postgresql+psycopg2://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?sslmode=require"

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False

# ==============================================================================
# 3. EMAIL & TRANSACTIONAL DELIVERY (Resend API & SMTP)
# ==============================================================================
# Production transactional email delivery for account verification, password reset,
# and passwordless OTP authentication.
#
# Resend API Key:
# Obtain your key from https://resend.com/api-keys (starts with re_)
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# Sender Display & Address:
# - Default / Instant Onboarding: "Technea <onboarding@resend.dev>"
#   (Works immediately with zero DNS setup. Delivers to your registered Resend account email)
# - Custom Production Domain: "Technea <noreply@yourdomain.com>"
#   (Requires adding SPF/DKIM DNS records to your domain in the Resend Dashboard)
EMAIL_FROM="Technea <onboarding@resend.dev>"

# Optional SMTP Fallback Settings (e.g. Amazon SES, SendGrid, Gmail SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=True

# OTP Security Policies
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Google Gemini Intelligence
GEMINI_API_KEY="AIzaSyYourProductionGeminiApiKeyHere"
GEMINI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=30

# Web Server Port (injected automatically by PaaS)
PORT=8000

