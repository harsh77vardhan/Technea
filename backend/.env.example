# -----------------------------------------------------------------------------
# Technea Backend Environment Configuration
# -----------------------------------------------------------------------------

# Application Settings
PROJECT_NAME="Technea API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="generate-a-secure-random-secret-key-for-production"

# API Routing
API_V1_STR="/api/v1"

# CORS Settings (JSON list or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://technea.dev","https://technea.vercel.app"]
# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="technea_db"

# Database Connection URLs (Overwrites component variables if set)
# Async URL used by FastAPI and SQLAlchemy 2.0 async engine:
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/technea_db"

# Sync URL used for Alembic migrations if needed:
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres_password@localhost:5432/technea_db"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=True
DB_ECHO=False

# Frontend URL (for email verification & password reset links)
FRONTEND_URL="http://localhost:3000"

# AI & Gemini Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=30

# Email & Transactional Delivery (Resend API & SMTP)
# Leave RESEND_API_KEY unset to log emails to console in development
RESEND_API_KEY=""
EMAIL_FROM="Technea <onboarding@resend.dev>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=True
SMTP_SSL=False

