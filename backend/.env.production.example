# ==============================================================================
# Technea Backend - Production Environment Variables Example
# ==============================================================================
# Copy this file to .env in production or configure each variable in your PaaS 
# dashboard (Render, Railway, Fly.io, AWS ECS, Heroku).
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Security
# ------------------------------------------------------------------------------
PROJECT_NAME="Technea API"
VERSION="0.1.0"
ENVIRONMENT="production"
DEBUG=False

# IMPORTANT: Generate a cryptographically secure 64-character secret key:
# Command: openssl rand -hex 32
SECRET_KEY="replace-with-a-cryptographically-secure-random-32-byte-secret-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ------------------------------------------------------------------------------
# Routing & CORS Configuration
# ------------------------------------------------------------------------------
API_V1_STR="/api/v1"

# Allowed frontend origin URLs. Must match your deployed frontend exact domain!
# JSON array format: ["https://technea.vercel.app", "https://app.technea.com"]
# Or comma-separated format: https://technea.vercel.app,https://app.technea.com
CORS_ORIGINS=["https://technea.vercel.app","https://your-custom-domain.com"]

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Primary asynchronous connection URL for FastAPI and SQLAlchemy 2.0 (asyncpg):
# Examples:
# Neon:      postgresql+asyncpg://user:pass@ep-cool-123456.us-east-2.aws.neon.tech/technea?sslmode=require
# Supabase:  postgresql+asyncpg://postgres:pass@db.xxxx.supabase.co:5432/postgres?sslmode=require
# Railway:   postgresql+asyncpg://postgres:pass@roundhouse.proxy.rlwy.net:12345/railway
# Render:    postgresql+asyncpg://technea_user:pass@dpg-xxxx.oregon-postgres.render.com/technea_db
DATABASE_URL="postgresql+asyncpg://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?sslmode=require"

# Synchronous connection URL used for Alembic database schema migrations (psycopg2):
SYNC_DATABASE_URL="postgresql+psycopg2://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?sslmode=require"

# Connection Pooling Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False

# ------------------------------------------------------------------------------
# Google Gemini AI Intelligence
# ------------------------------------------------------------------------------
# Acquire from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourProductionGeminiApiKeyHere"
GEMINI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# Server Network Port
# ------------------------------------------------------------------------------
# Automatically set by cloud platforms (e.g. Render, Railway, Cloud Run). Defaults to 8000.
PORT=8000
